{
  "name": "pulsecheck",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "start": "npm --workspace server start",
    "dev:server": "npm --workspace server run dev",
    "dev:client": "npm --workspace client run dev",
    "dev:worker": "npm --workspace server run worker:dev",
    "start:worker": "npm --workspace server run worker",
    "start:worker:once": "npm --workspace server run worker:once",
    "migrate": "npm --workspace server run migrate",
    "test": "npm --workspace server test",
    "build": "npm --workspace client run build"
  },
  "engines": {
    "node": ">=20.19"
  }
}
