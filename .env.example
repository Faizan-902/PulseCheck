# PostgreSQL connection settings. Copy this file to .env and set your own values.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=pulsecheck
PGUSER=postgres
PGPASSWORD=change-me
PGSSLMODE=disable

# API settings
HOST=127.0.0.1
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
CHECK_TIMEOUT_MS=5000

# Scheduled monitoring worker
WORKER_POLL_INTERVAL_MS=5000
WORKER_BATCH_SIZE=10
