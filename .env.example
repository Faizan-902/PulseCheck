# Local PostgreSQL settings. Production must use PGSSLMODE=require.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=pulsecheck
PGUSER=postgres
PGPASSWORD=change-me
PGSSLMODE=disable
# Local default: 10. Vercel serverless instances default to 2.
PGPOOL_MAX=10

# API settings
HOST=127.0.0.1
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
AUTH_SESSION_TTL_HOURS=168
CHECK_TIMEOUT_MS=5000

MAX_ENDPOINTS_PER_USER=10

# Scheduled monitoring worker
SCHEDULER_MODE=cron
MIN_EFFECTIVE_INTERVAL_SECONDS=900
WORKER_POLL_INTERVAL_MS=5000
WORKER_BATCH_SIZE=10

# Optional Google OAuth 2.0 (Authorization Code + PKCE)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
